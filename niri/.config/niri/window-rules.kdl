window-rule {
    match app-id=r#"zen$"# title="^Picture-in-Picture$"
    open-floating true
}

window-rule {
    match app-id=r#"zen$"# title="^Bitwarden$"
    open-floating true
}

window-rule {
    match app-id="Pinentry-gtk"
    open-floating true
}

window-rule {
    match app-id="com.saivert.pwvucontrol"
    open-floating true
}

window-rule {
    match app-id=r#"firefox$"#
    match app-id="kitty" title="termusic-player"
    match app-id="kitty" title="rmpc-player"
    open-maximized true
}

window-rule {
    match app-id="steam" title=r#"^notificationtoasts_\d+_desktop$"#
    default-floating-position x=10 y=10 relative-to="bottom-right"
}

window-rule {
    match app-id=r#"^org\.keepassxc\.KeePassXC$"#
    match app-id=r#"^org\.gnome\.World\.Secrets$"#
    match title="^Bitwarden$"

    block-out-from "screen-capture"
}

window-rule {
    match app-id="floating"
    open-floating true
}
