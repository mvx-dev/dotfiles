# Environments — text mode, manual
global !p
from globals import *
endglobal

snippet dm "Display math" Ai

\[
	${1}
\]
endsnippet

snippet beg "begin/end block" w
\begin{$1}
	$0
\end{$1}
endsnippet

snippet eq "equation" w
\begin{equation}
	$1
\end{equation}$0
endsnippet

snippet ali "align" w
\begin{align*}
	$1 &= $2 \\\\
\end{align*}$0
endsnippet

snippet gat "gather" w
\begin{gather}
	$1
\end{gather}$0
endsnippet

snippet cas "cases" w
\begin{cases}
	$1 & $2 \\\\
	$3 & $4
\end{cases}$0
endsnippet

snippet fig "figure" w
\begin{figure}[${1:htbp}]
	\centering
	\includegraphics[width=${2:0.8}\linewidth]{$3}
	\caption{$4}
	\label{fig:$5}
\end{figure}$0
endsnippet

snippet tab "tabular" w
\begin{table}[${1:htbp}]
	\centering
	\caption{$2}
	\label{tab:$3}
	\begin{tabular}{$4}
		\hline
		$0
		\hline
	\end{tabular}
\end{table}
endsnippet

snippet itm "itemize" w
\begin{itemize}
	\item $1
\end{itemize}$0
endsnippet

snippet enu "enumerate" w
\begin{enumerate}
	\item $1
\end{enumerate}$0
endsnippet

snippet desc "description" w
\begin{description}
	\item[$1] $2
\end{description}$0
endsnippet

snippet thm "theorem" w
\begin{theorem}
	$1
\end{theorem}$0
endsnippet

snippet lem "lemma" w
\begin{lemma}
	$1
\end{lemma}$0
endsnippet

snippet proof "proof" w
\begin{proof}
	$1
\end{proof}$0
endsnippet

snippet cal "LaTeX callout" b
\begin{callout}{${1:info}}[${2:${1/^(.)/\u$1/}}]
$0
\end{callout}
endsnippet
