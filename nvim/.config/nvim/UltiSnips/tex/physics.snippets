# Physics (Dirac notation etc.) — math only, manual
# Requires: \usepackage{physics} or manual definitions
global !p
from globals import *
endglobal


context "math()"
snippet ket "\ket{}" wmA
\ket{$1}$0
endsnippet

context "math()"
snippet bra "\bra{}" wmA
\bra{$1}$0
endsnippet

context "math()"
snippet brk "\braket{}{}" wmhA
\braket{$1}{$2}$0
endsnippet

context "math()"
snippet ev "\ev{}{}" wm
\ev{$1}{$2}$0
endsnippet

context "math()"
snippet comm "\comm{}{}" wm
\comm{$1}{$2}$0
endsnippet

context "math()"
snippet acomm "\acomm{}{}" wm
\acomm{$1}{$2}$0
endsnippet

context "math()"
snippet rr "script r" iAm
\scriptr
endsnippet

context "math()"
snippet LL "\mathcal{L}" iAm
\mathcal{L}
endsnippet

context "math()"
snippet ll "\ell" wAm
\ell
endsnippet

context "math()"
snippet hbr "\hbar" wAm
\hbar
endsnippet

context "math()"
snippet ham "Hamiltonian" wAm
\mathcal{H}
endsnippet
