# Superscripts — math only, regex automatic
global !p
from globals import *
endglobal


priority 20

context "math()"
snippet "(\w)2" "x^2" riAm
`!p snip.rv = match.group(1)`^2
endsnippet

context "math()"
snippet "(\w)3" "x^3" riAm
`!p snip.rv = match.group(1)`^3
endsnippet

context "math()"
snippet "(\w)n'" "x^n" riAm
`!p snip.rv = match.group(1)`^n
endsnippet

context "math()"
snippet "(\w)T" "x^\top" riAm
`!p snip.rv = match.group(1)`^\top
endsnippet

context "math()"
snippet "(\w)H" "x^\dagger" riAm
`!p snip.rv = match.group(1)`^\dagger
endsnippet

context "math()"
snippet "(\w)in" "x^{-1}" riAm
`!p snip.rv = match.group(1)`^{-1}
endsnippet
